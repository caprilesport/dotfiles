# Set the layout for the current tab
layout tall
# Set the working directory for windows in the current tab
cd ~/projects/recli
# Create the "main" window and run an editor in it to edit the project files
launch /home/vport/.local/bin/pi --continue

new_tab hx
cd ~/projects/recli
launch hx .

new_tab scratch
layout splits
cd ~/projects/recli
launch --var window=shell nu
launch --location=vsplit --bias 60 bacon 

new_tab git
cd ~/projects/recli
launch lazygit

focus_tab 1
