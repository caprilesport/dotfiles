# Set the layout for the current tab
layout tall
# Set the working directory for windows in the current tab
cd ~/projects/LaMP/benchmark
# Create the "main" window and run an editor in it to edit the project files
launch /home/vport/.local/bin/pi

new_tab hx
cd ~/projects/LaMP/benchmark
launch hx .

new_tab scratch
layout splits
cd ~/projects/LaMP/benchmark
launch --var window=shell nu
launch --location=hsplit --bias=20 typst watch ./report/main.typ
launch --location=vsplit nu

new_tab git
cd ~/projects/LaMP/benchmark
launch lazygit

focus_tab 1
