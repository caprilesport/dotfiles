{#-
software = "orca"
jobtype = "optfreq"
requires = ["method", "basis_set", "charge", "mult", "nprocs", "mem", "Molecule"]
description = "Geometry optimization followed by numerical frequency"
-#}! xtb
! Opt NumFreq

%xtb
  XTBINPUTSTRING  "--gxtb" 
end

%pal
 nprocs {{ nprocs }}
end

{% if maxiter is defined -%}
%geom
 maxiter {{ maxiter }}{% if start_hessian is defined and start_hessian %}
 InHess Read
 InHessName "{{ name }}.hess" {% endif %}
end

{% endif -%}
*xyz {{ charge }} {{ mult }}
{{ print_coords(molecule = Molecule) }}
*
