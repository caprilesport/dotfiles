{#-
software = "orca"
jobtype = "neb"
requires = ["method", "basis_set", "charge", "mult", "nprocs", "mem", "Molecule"]
description = "Nudged elastic band — provide reactant as input, place product as name.end.xyz"
-#}! xtb NEB

%xtb
  XTBINPUTSTRING  "--gxtb" 
end

{% if pmodel -%}
%scf 
  guess PModel # or HCore
end
{% endif -%}

%pal
 nprocs {{ nprocs }}
end

%neb
 neb_end_xyzfile "{{ name }}.end.xyz"
 nimages {% if nimages is defined %}{{ nimages }}{% else %}{{ nprocs }}{% endif %}
 preopt_ends true
end

*xyz {{ charge }} {{ mult }}
{{ print_coords(molecule = Molecule) }}
*

