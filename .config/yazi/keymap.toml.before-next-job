[[mgr.prepend_keymap]]
on   = "l"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"

[[mgr.prepend_keymap]]
on   = "<Enter>"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"

[[mgr.prepend_keymap]]
on   = [ "g", "i" ]
run  = "plugin gedent"
desc = "Generate a chemistry input with Gedent"

[[mgr.prepend_keymap]]
on   = [ "g", "n" ]
run  = "plugin gedent -- init"
desc = "Initialize a Gedent project with selected parameters"

[[mgr.prepend_keymap]]
on   = [ "g", "s" ]
run  = "plugin recli"
desc = "Submit the hovered ORCA input to Jupiter"

[[mgr.prepend_keymap]]
on   = [ "g", "l" ]
run  = "plugin recli -- local"
desc = "Add the hovered ORCA input to the local Pueue queue"

[[mgr.prepend_keymap]]
on   = [ "g", "r" ]
run  = "plugin recli -- fetch"
desc = "Fetch and show updated Recli job statuses"
